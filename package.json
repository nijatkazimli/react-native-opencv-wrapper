{
  "name": "@nijatk/react-native-opencv-wrapper",
  "version": "0.1.4",
  "description": "React Native wrapper for OpenCV with optional bundled binaries",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nijatkazimli/react-native-opencv-wrapper.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react-native",
    "opencv",
    "opencv4",
    "react-native-module",
    "native-module"
  ],
  "files": [
    "lib",
    "src",
    "README.md",
    "package.json"
  ],
  "source": "src",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    }
  },
  "codegenConfig": {
    "name": "ReactNativeOpencvWrapperSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.nijatk.reactnativeopencvwrapper"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "author": "Nijat Kazimli <nijat@example.com> (https://github.com/nijatkazimli)",
  "license": "MIT",
  "homepage": "https://github.com/nijatkazimli/react-native-opencv-wrapper#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "scripts": {
    "build": "bob build",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@react-native/babel-preset": "0.85.3",
    "@types/react": "^19.2.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.62.0"
  }
}
