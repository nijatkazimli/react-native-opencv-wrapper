{
  "name": "@nijatk/react-native-opencv-wrapper",
  "version": "0.0.0",
  "description": "React Native wrapper for OpenCV with optional bundled binaries",
  "main": "src/index",
  "codegenConfig": {
    "name": "ReactNativeOpencvWrapperSpec",
    "type": "modules",
